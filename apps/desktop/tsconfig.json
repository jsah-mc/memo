{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolvePackageJsonImports": true
  },
  "exclude": [
    "src/api/**/*",
    "src-tauri/**/*",
    "node_modules",
    "out",
    "dist",
    ".vite"
  ]
}
