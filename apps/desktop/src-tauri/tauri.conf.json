{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "1.1.2",
  "identifier": "dev.memo.desktop",
  "build": {
    "beforeDevCommand": "pnpm start:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memo",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://logos.composio.dev; media-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:4010; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.gateway-build/gateway": "gateway"
    }
  }
}
