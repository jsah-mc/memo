# Memo gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000

# Codex through a ChatGPT subscription
CHATGPT_TOKEN_DIR=C:\Users\Admin\.codex
CHATGPT_AUTH_FILE=auth.json

# Fully local speech
MEMO_WHISPER_MODEL=small.en
MEMO_WHISPER_DEVICE=cuda
# Quantized CUDA uses substantially less VRAM than FP16 while staying fast.
MEMO_WHISPER_COMPUTE_TYPE=int8_float16
MEMO_POCKETTTS_DEVICE=cuda
# Smaller generation chunks reduce time to first speech.
MEMO_POCKETTTS_MAX_TOKENS=24
# Keep preloaded models resident for instant first use (0 disables idle unload).
MEMO_SPEECH_IDLE_TIMEOUT_SECONDS=0
# Leave CPU capacity available for the UI.
MEMO_SPEECH_CPU_THREADS=4
# Load both STT and TTS as the gateway starts.
MEMO_SPEECH_PRELOAD=1

# Browser Use opens a visible Chromium window by default.
# Set to 1 only when you want background/headless browser automation.
MEMO_BROWSER_HEADLESS=0

# The Textual program enables restricted computer tools by default. The HTTP
# gateway requires both this opt-in and X-Memo-Computer-Tools: 1 per request.
# MEMO_COMPUTER_ENABLED=1
# MEMO_SANDBOX_ROOT=C:\Users\Admin\Documents\memo\.memo-sandbox
