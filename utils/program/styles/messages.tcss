/* Modern Textual TUI Chat Messages styling */
.chat-message {
  width: 100%;
  height: auto;
  margin-bottom: 1;
  padding: 1 2;
  border-radius: 1;
}

.user-message {
  background: #1e293b;
  border-left: thick #3b82f6;
  color: #f8fafc;
}

.assistant-message {
  background: #0f172a;
  border-left: thick #10b981;
  color: #e2e8f0;
}

.tool-message {
  color: #94a3b8;
  background: #18181b;
  border-left: thick #eab308;
}
