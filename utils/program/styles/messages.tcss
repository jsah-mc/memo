Screen {
  background: $background;
  color: $text;
}

Screen.desktop-control-active {
  border: tall $warning;
}

.chat-message {
  width: 100%;
  height: auto;
  min-height: 3;
  margin: 0 0 1 0;
  padding: 1 3;
  color: $text;
}

.user-message {
  background: $boost 45%;
  border-left: solid $primary;
  text-style: bold;
}

.assistant-message {
  background: $background;
  border-left: solid $secondary 35%;
}

.tool-message {
  min-height: 2;
  padding: 0 3;
  color: $text-muted;
  background: $surface;
  border-left: solid $warning 55%;
}

VerticalScroll > ScrollBar {
  background: $background;
  color: $boost;
}
